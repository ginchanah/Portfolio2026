---
const {
    title,
    imgSrc,
    imgAlt = '',
    pageLink = '',
} = Astro.props;
---

<li>
    <article class="project">
    
        
        <div class="project-layout white-content black-border scroll-animation">
                <div class="white-heading">
                    <h3>{title}</h3>
                </div>
                <figure class="photo">
                    <img src={imgSrc} alt={imgAlt} class="project-image" />
                </figure>
    
    
        </div>
    
            
            <div class="project-short scroll-animation">
                <em><slot name="short" /></em>
            </div>
            
            <div class="project-long scroll-animation">
                <slot name="long" />
            </div>
            
            <a class="visit-site scroll-animation" href={pageLink}>Visit the site<span class="visually-hidden">{title}</span>!</a>
    
    </article>
</li>